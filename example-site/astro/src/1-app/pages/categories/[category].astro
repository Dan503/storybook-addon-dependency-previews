---
import { fetchMealsByCategory } from 'example-site-shared/utils'
import CategoryMealListPage from '../../../2-pages/CategoriesPage/CategoryMealListPage/CategoryMealListPage.astro'
import BaseLayout from '../../BaseLayout.astro'

export const prerender = false

const { category } = Astro.params

const mealsByCategory = await fetchMealsByCategory(category ?? '')

if (!mealsByCategory || mealsByCategory.length === 0) {
	// navigate to the 404 page if no meal is found
	return Astro.rewrite('/404')
}
---

<BaseLayout title={`${category} meals`}>
	<CategoryMealListPage
		categoryName={category!}
		categoryDescription={`Explore the delicious ${category?.toLowerCase()} meals!`}
		meals={mealsByCategory}
	/>
</BaseLayout>
