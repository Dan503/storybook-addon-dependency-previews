---
import { fetchMealById, type Meal } from 'example-site-shared/utils'
import BaseLayout from '../../BaseLayout.astro'
import MealPage from '../../../2-pages/MealPage/MealPage.astro'

export const prerender = false

const { mealId } = Astro.params

const meal: Meal | null = mealId ? await fetchMealById(mealId) : null

if (!meal) {
	// navigate to the 404 page if no meal is found
	return Astro.rewrite('/404')
}
---

<BaseLayout
	title={meal.name}
	description={`Discover how to cook ${meal.name}.`}
>
	<MealPage meal={meal} />
</BaseLayout>
