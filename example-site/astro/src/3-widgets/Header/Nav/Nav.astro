---
/** The site's main links. The link to the page being viewed is marked as the current page. */
interface Props {
	/**
	 * The page path to mark as current. Leave it out on the real site, where it
	 * defaults to the page being viewed. Stories set it, because Storybook does
	 * not render at a real page address.
	 */
	currentPath?: string
}
const { currentPath = Astro.url.pathname } = Astro.props

const navLinks = [
	{ href: '/', text: 'Home' },
	{ href: '/categories', text: 'Food categories' },
	{ href: '/contact', text: 'Contact us' },
]

const currentPathWithoutSlash = removeTrailingSlash(currentPath)

/** `/contact/` and `/contact` are the same page, so compare them without the final slash. */
function removeTrailingSlash(path: string) {
	const isRoot = path === '/'
	if (isRoot || !path.endsWith('/')) {
		return path
	}
	return path.slice(0, -1)
}
---

<nav class="Nav">
	<ul>
		{navLinks.map((link) => {
			const isCurrentPage = link.href === currentPathWithoutSlash
			return (
				<li>
					<a href={link.href} aria-current={isCurrentPage ? 'page' : undefined}>
						{link.text}
					</a>
				</li>
			)
		})}
	</ul>
</nav>

<style>
	ul {
		list-style: none;
		margin: 0;
		padding: 0;
		display: flex;
		justify-content: center;
		gap: 1em;
		font-weight: bold;
	}

	a {
		color: var(--text);
		text-decoration: none;

		&:hover,
		&:focus,
		&[aria-current='page'] {
			text-decoration: underline;
		}

		&[aria-current='page'] {
			&:hover,
			&:focus {
				text-decoration: none;
			}
		}
	}
</style>
