---
import ScreenPadding from '../../ScreenPadding/ScreenPadding.astro'
import type { PropsForCard } from '../Card/Card.types'
import CardListing from '../CardListing.astro'

interface Props {
	title: string
	description?: string
	cards: Array<PropsForCard>
}
const { title, description, cards } = Astro.props
---

<ScreenPadding padVertical>
	<div class="ListingPage">
		<div>
			<h1>{title}</h1>
			{description && <p>{description}</p>}
		</div>
		<CardListing cards={cards} headingLevel={2} />
	</div>
</ScreenPadding>

<style>
	.ListingPage {
		display: grid;
		gap: 1.5em;
	}
</style>
