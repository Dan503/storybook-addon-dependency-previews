---
// 6-shared/ui/Icons/Svg.astro
import type { PropsForIcon } from './Icon.types'

/** The outer `<svg>` every icon draws its shapes inside. */
interface Props extends PropsForIcon {}
const { altText, class: className } = Astro.props

const fixedAttributes = {
	xmlns: 'http://www.w3.org/2000/svg',
	fill: 'none',
	viewBox: '0 0 24 24',
	'stroke-width': 1.5,
	stroke: 'currentColor',
	height: 24,
	width: 24,
	focusable: 'false',
}
---

<svg
	{...fixedAttributes}
	role="img"
	aria-label={altText || undefined}
	aria-hidden={altText ? undefined : 'true'}
	class={className}
>
	<slot />
</svg>
