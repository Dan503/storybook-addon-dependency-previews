---
/**
 * Used for setting up container queries.
 * It is a grid so what's inside stretches to its full height, e.g. a card filling the height of its row.
 */
interface Props {
	classes?: Array<string> | string
}
const { classes = [] } = Astro.props
const classList = typeof classes === 'string' ? [classes] : classes
---

<div class:list={['QueryContainer', ...classList]}>
	<slot />
</div>

<style>
	.QueryContainer {
		container-type: inline-size;
		display: grid;
		width: 100%;
	}
</style>
