{
	"name": "example-site-lit",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "vite",
		"build": "vite build",
		"preview": "vite preview",
		"sb:docs": "cem analyze --litelement --globs \"src/**/*.lit.ts\"",
		"sb:deps": "sb-deps",
		"sb": "pnpm run sb:docs && sb-deps --watch --run-storybook",
		"sb:build": "pnpm --filter storybook-addon-dependency-previews build && pnpm run sb:docs && node ../../storybook-addon-package/dist/cli/sb-deps.cjs && storybook build",
		"format": "prettier --write .",
		"typecheck": "tsc --noEmit",
		"lint": "lit-analyzer --strict",
		"check": "pnpm run typecheck && pnpm run lint"
	},
	"dependencies": {
		"example-site-shared": "workspace:*",
		"lit": "^3.3.3"
	},
	"devDependencies": {
		"@chromatic-com/storybook": "^5.3.1",
		"@custom-elements-manifest/analyzer": "^0.11.0",
		"@storybook/addon-docs": "^10.6.0",
		"@storybook/addon-links": "^10.6.0",
		"@storybook/web-components-vite": "^10.6.0",
		"dependency-cruiser": "^18.2.0",
		"lit-analyzer": "^2.0.3",
		"prettier": "^3.8.1",
		"storybook": "^10.6.0",
		"storybook-addon-dependency-previews": "workspace:*",
		"ts-lit-plugin": "^2.0.2",
		"typescript": "~5.9.3",
		"vite": "^7.0.4"
	},
	"customElements": "custom-elements.json"
}
